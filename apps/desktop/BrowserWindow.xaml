<Window x:Class="Veil.Desktop.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEIL · 개발자용" Icon="Assets/veil.ico" Width="1180" Height="780" MinWidth="620" MinHeight="440"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- title bar + tabs -->
                <RowDefinition Height="Auto" /> <!-- toolbar -->
                <RowDefinition Height="Auto" /> <!-- developer notice -->
                <RowDefinition Height="Auto" /> <!-- find bar -->
                <RowDefinition Height="Auto" /> <!-- active downloads -->
                <RowDefinition Height="*" />    <!-- pages -->
                <RowDefinition Height="Auto" /> <!-- status -->
            </Grid.RowDefinitions>

            <!-- Title bar: logo, tabs, new tab, window buttons. -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="Logo" Width="22" Height="22" Margin="14,0,10,0" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="LogoSpin" />
                    </Grid.RenderTransform>
                    <!-- Soft Veil: keep the original SVG proportions and colors. -->
                    <Viewbox Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="256" Height="256">
                            <Rectangle Canvas.Left="12" Canvas.Top="12" Width="232" Height="232" RadiusX="53" RadiusY="53">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#251C42" Offset="0" />
                                        <GradientStop Color="#141126" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Canvas.Left="12.5" Canvas.Top="12.5" Width="231" Height="231" RadiusX="52.5" RadiusY="52.5"
                                       Stroke="#1FFFFFFF" StrokeThickness="1" />
                            <Path Data="M50 77 c40 -21 74 -15 106 12 l50 42 c-39 16 -72 12 -104 -15 z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#DFC5FF" Offset="0" />
                                        <GradientStop Color="#886DFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M50 111 c40 -21 74 -15 106 12 l50 42 c-39 16 -72 12 -104 -15 z" Fill="#A695FF" Opacity="0.62" />
                            <Path Data="M50 145 c40 -21 74 -15 106 12 l50 42 c-39 16 -72 12 -104 -15 z" Fill="#EFE8FF" Opacity="0.87" />
                        </Canvas>
                    </Viewbox>
                </Grid>
                <Grid x:Name="TabHost" Grid.Column="1" ClipToBounds="True" SizeChanged="TabHostSizeChanged">
                    <StackPanel x:Name="TabRow" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TabControl x:Name="Tabs" Style="{StaticResource TabStrip}" VerticalAlignment="Bottom"
                                    SelectionChanged="TabChanged" AutomationProperties.Name="브라우저 탭"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="NewTab" Style="{StaticResource IconButton}" Content="&#xE710;"
                                Width="30" Height="30" FontSize="12" Margin="4,4,0,0" VerticalAlignment="Center"
                                Click="NewTabClick" ToolTip="새 탭 (Ctrl+T)" AutomationProperties.Name="새 탭"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="Caption" Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeClick"
                            AutomationProperties.Name="최소화" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="MaximizeClick" AutomationProperties.Name="최대화" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseWindowClick"
                            AutomationProperties.Name="닫기" />
                </StackPanel>
            </Grid>

            <!-- Toolbar sits on the same ink plate as the selected tab. -->
            <Grid x:Name="Toolbar" Grid.Row="1" Background="{StaticResource InkBrush}">
                <Grid Margin="10,7,10,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NavGroup" Orientation="Horizontal">
                        <Button x:Name="Back" Style="{StaticResource IconButton}" Content="&#xE72B;" IsEnabled="False"
                                ToolTip="뒤로 (Alt+←)" AutomationProperties.Name="뒤로" Click="BackClick" />
                        <Button x:Name="Forward" Style="{StaticResource IconButton}" Content="&#xE72A;" IsEnabled="False"
                                ToolTip="앞으로 (Alt+→)" AutomationProperties.Name="앞으로" Click="ForwardClick" />
                        <Button x:Name="Reload" Style="{StaticResource IconButton}" IsEnabled="False"
                                ToolTip="새로고침 (Ctrl+R)" AutomationProperties.Name="새로고침" Click="ReloadClick">
                            <TextBlock x:Name="ReloadGlyph" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    <Grid x:Name="AddressHost" Grid.Column="1" Margin="10,0" MaxWidth="860"
                          RenderTransformOrigin="0.5,0.5">
                        <TextBox x:Name="Address" Style="{StaticResource PillTextBox}" Height="34" Tag="&#xE721;"
                                 ToolTip="주소 또는 검색 (Ctrl+L)" AutomationProperties.Name="주소 또는 검색어"
                                 KeyDown="AddressKeyDown" GotKeyboardFocus="AddressGotFocus" />
                        <Popup x:Name="AddressSuggestionsPopup" PlacementTarget="{Binding ElementName=Address}"
                               Placement="Bottom" AllowsTransparency="True" StaysOpen="True" Focusable="False">
                            <Border Width="{Binding ActualWidth, ElementName=Address}" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
                                <ListBox x:Name="AddressSuggestionsList" Style="{StaticResource VeilList}" MaxHeight="350"
                                         Focusable="False" AutomationProperties.Name="로컬 주소 추천"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <StackPanel x:Name="ActionGroup" Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BookmarkButton" Style="{StaticResource IconButton}" ToolTip="북마크 추가 (Ctrl+D)"
                                AutomationProperties.Name="북마크 추가" Click="BookmarkClick">
                            <TextBlock x:Name="BookmarkGlyph" Text="&#xE734;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button x:Name="DownloadButton" Style="{StaticResource IconButton}"
                                ToolTip="최근 다운로드" AutomationProperties.Name="최근 다운로드"
                                Click="DownloadToolbarClick" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="28" Height="28" IsHitTestVisible="False">
                                <Ellipse x:Name="DownloadRingTrack" Margin="2" Stroke="{StaticResource LineBrush}"
                                         StrokeThickness="2" Visibility="Collapsed" />
                                <Path x:Name="DownloadRingArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <TextBlock Text="&#xE896;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Popup x:Name="DownloadPopup" PlacementTarget="{Binding ElementName=DownloadButton}"
                               Placement="Bottom" HorizontalOffset="-318" VerticalOffset="6"
                               AllowsTransparency="True" StaysOpen="False"
                               Opened="DownloadPopupOpened" Closed="DownloadPopupClosed">
                            <Border Width="354" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14"
                                    KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="DownloadPopupKeyDown">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                Content="&#xE8BB;" Click="CloseDownloadPopupClick" AutomationProperties.Name="최근 다운로드 닫기" />
                                        <TextBlock Text="최근 다운로드" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="다운로드 금고 열기"
                                                Click="PopupVaultClick" Margin="0,0,0,6" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="모든 다운로드 보기" Click="DownloadsClick" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <ItemsControl x:Name="PopupActiveDownloads" AutomationProperties.Name="진행 중인 다운로드">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                                <ProgressBar Height="4" Margin="0,5,0,0" Maximum="100"
                                                                             Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                                                                             Foreground="{StaticResource AccentBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="취소"
                                                                    IsEnabled="{Binding CanCancel}" Click="CancelDownloadClick" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl x:Name="RecentDownloadsList" AutomationProperties.Name="최근 다운로드 결과">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="DownloadPopupEmpty" Text="최근 다운로드가 없습니다."
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,12" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DownloadPopupLocked" Text="금고를 열면 보관된 다운로드를 확인할 수 있습니다."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE700;" ToolTip="브라우저 메뉴 (Alt+F)"
                                AutomationProperties.Name="브라우저 메뉴" Click="MenuClick">
                            <Button.ContextMenu>
                                <ContextMenu Opened="MenuOpened">
                                    <MenuItem Header="새 탭" InputGestureText="Ctrl+T" Click="NewTabClick" />
                                    <MenuItem Header="새 창" InputGestureText="Ctrl+N" Click="NewWindowClick" />
                                    <MenuItem Header="닫은 탭 복원" InputGestureText="Ctrl+Shift+T" Click="RestoreClick" />
                                    <MenuItem Header="탭 검색" InputGestureText="Ctrl+Shift+A" Click="TabSearchClick" />
                                    <Separator />
                                    <MenuItem Header="북마크 추가" InputGestureText="Ctrl+D" Click="BookmarkClick" />
                                    <MenuItem Header="북마크 관리" InputGestureText="Ctrl+B" Click="BookmarksClick" />
                                    <MenuItem x:Name="BookmarkBarMenuItem" Header="북마크 바 표시" IsCheckable="True"
                                              InputGestureText="Ctrl+Shift+B" Click="ToggleBookmarkBarClick" />
                                    <MenuItem Header="방문 기록" InputGestureText="Ctrl+H" Click="HistoryClick" />
                                    <MenuItem Header="다운로드" InputGestureText="Ctrl+J" Click="DownloadsClick" />
                                    <MenuItem Header="다운로드 금고" InputGestureText="Ctrl+Shift+J" Click="VaultClick" />
                                    <MenuItem Header="비밀번호 관리자" Click="PasswordsClick" />
                                    <MenuItem Header="페이지 내 검색" InputGestureText="Ctrl+F" Click="FindClick" />
                                    <Separator />
                                    <MenuItem Header="설정" InputGestureText="Ctrl+," Click="SettingsClick" />
                                    <Separator />
                                    <MenuItem Header="전체 화면" InputGestureText="F11" Click="FullScreenClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Navigation progress line along the toolbar's bottom edge. -->
                <Grid x:Name="Progress" Height="2" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False">
                    <Border x:Name="ProgressFill" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="ProgressGleam" Width="140" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#CCFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>

            <!-- The developer warning stays visible on every page. -->
            <StackPanel Grid.Row="2">
            <Border x:Name="BookmarkBar" Background="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="10,2" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="28"
                            Content="&#xE734;" ToolTip="북마크 관리" Click="BookmarksClick" AutomationProperties.Name="모든 북마크" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="BookmarkBarItems" AutomationProperties.Name="북마크 바">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Height="26" Margin="0,0,4,0" Padding="8,0"
                                                ToolTip="{Binding Url}" Click="BookmarkBarItemClick"
                                                AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" MaxWidth="155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="BookmarkBarEmpty" Text="Ctrl+D로 북마크를 추가하세요."
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="5,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="Notice" Background="#14F2B84B" BorderBrush="#33F2B84B"
                    BorderThickness="0,1,0,1" Padding="14,5">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse x:Name="NoticePulse" Fill="{StaticResource AmberBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Fill="{StaticResource AmberBrush}" />
                    </Grid>
                    <TextBlock Foreground="#F5D08A" FontSize="12" TextWrapping="Wrap"
                               Text="개발자용 · 테스트 데이터만 사용하세요. 프로필과 기록은 암호화되지 않습니다." />
                </StackPanel>
            </Border>
            <!-- ADR-0006: the HTTP downgrade is a native control so no web content can trigger it. -->
            <Border x:Name="HttpsBar" Visibility="Collapsed" Background="#1FE5484D" BorderBrush="#55E5484D"
                    BorderThickness="0,0,0,1" Padding="14,6">
                <DockPanel>
                    <Button x:Name="AllowHttpButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Content="위험을 이해하고 HTTP로 계속" Click="AllowHttpClick"
                            AutomationProperties.Name="이 사이트를 HTTP로 계속 열기" />
                    <TextBlock x:Name="HttpsBarText" Foreground="#F3B3B5" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="이 사이트는 안전한 연결(HTTPS)을 사용할 수 없습니다." />
                </DockPanel>
            </Border>
            <!-- ADR-0008: continuing past a VEIL threat warning is a native control only. -->
            <Border x:Name="ThreatBar" Visibility="Collapsed" Background="#1FE5484D" BorderBrush="#55E5484D"
                    BorderThickness="0,0,0,1" Padding="14,6">
                <DockPanel>
                    <Button x:Name="ProceedThreatButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Content="위험을 이해하고 계속" Click="ProceedThreatClick"
                            AutomationProperties.Name="위협 경고를 무시하고 이 사이트 열기" />
                    <TextBlock x:Name="ThreatBarText" Foreground="#F3B3B5" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="이 사이트는 VEIL 위협 목록에 있습니다." />
                </DockPanel>
            </Border>
            </StackPanel>

            <Border x:Name="FindBar" Grid.Row="3" Background="{StaticResource InkBrush}" Height="0"
                    Visibility="Collapsed" ClipToBounds="True">
                <StackPanel x:Name="FindContent" Orientation="Horizontal" Margin="14,7" VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <TextBox x:Name="FindText" Style="{StaticResource PillTextBox}" Width="260" Height="30"
                             Tag="&#xE721;" ToolTip="페이지 내 검색" AutomationProperties.Name="페이지 내 검색"
                             KeyDown="FindKeyDown" />
                    <Button Style="{StaticResource GhostButton}" Content="이전" Click="FindPreviousClick" />
                    <Button Style="{StaticResource GhostButton}" Content="다음" Click="FindNextClick" />
                    <Button Style="{StaticResource GhostButton}" Content="닫기" Click="FindCloseClick" />
                </StackPanel>
            </Border>

            <Border x:Name="DownloadProgressPanel" Grid.Row="4" Visibility="Collapsed"
                    Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="다운로드 금고 열기"
                                Click="VaultClick" AutomationProperties.Name="다운로드 금고 열기" />
                        <TextBlock Text="다운로드 관리" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ActiveDownloadsList" MaxWidth="920" Margin="18,8"
                                  AutomationProperties.Name="진행 중인 다운로드">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <ProgressBar Height="4" Margin="0,5,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" Foreground="{StaticResource AccentBrush}"
                                                     AutomationProperties.Name="{Binding Name}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="취소"
                                            IsEnabled="{Binding CanCancel}" Click="CancelDownloadClick" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid x:Name="Pages" Grid.Row="5" Background="{StaticResource InkBrush}" ClipToBounds="True">
                <!-- Home: drifting light, slow orbit rings and flowing strands behind the wordmark. -->
                <Grid x:Name="Home" IsVisibleChanged="HomeVisibleChanged">
                    <Canvas x:Name="Backdrop" IsHitTestVisible="False">
                        <Ellipse x:Name="OrbViolet" Width="620" Height="620" Opacity="0.55">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#668B7CFF" Offset="0" />
                                    <GradientStop Color="#008B7CFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="OrbCyan" Width="520" Height="520" Opacity="0.45">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#554FD1E8" Offset="0" />
                                    <GradientStop Color="#004FD1E8" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                    <Grid x:Name="Rings" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="RingOuter" Width="560" Height="560" StrokeThickness="1"
                                 StrokeDashArray="1 9" Stroke="#338B7CFF" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RingInner" Width="380" Height="380" StrokeThickness="1"
                                 StrokeDashArray="24 14" Stroke="#264FD1E8" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="380" Height="380" StrokeThickness="2" Stroke="{StaticResource AccentBrush}"
                                 StrokeDashArray="9 1000" StrokeDashCap="Round" x:Name="RingComet"
                                 RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <Canvas x:Name="Strands" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="220" />
                    <StackPanel x:Name="HomeContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <Grid x:Name="Wordmark" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Tagline" Text="주소창에 웹 주소 또는 검색어를 입력하세요" HorizontalAlignment="Center"
                                   Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   FontSize="14">
                            <TextBlock.RenderTransform>
                                <TranslateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Border x:Name="HintChip" HorizontalAlignment="Center" Margin="0,22,0,0" CornerRadius="14"
                                Padding="14,6" Background="#0FFFFFFF" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                <Run Text="Ctrl+L" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                <Run Text=" 주소창   ·   " />
                                <Run Text="Ctrl+T" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                <Run Text=" 새 탭" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="StatusBar" Grid.Row="6" Background="{StaticResource ChromeBrush}" Padding="14,5"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="Status" Text="엔진 시작 중…" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12">
                            <TextBlock.RenderTransform>
                                <TranslateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="NetworkIndicator" HorizontalAlignment="Right" Text="VEIL Developer Preview" FontSize="11"
                               Foreground="#5A6078" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
