<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/veil.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Keep existing local scripts/debug launch paths stable while exposing Windows PDF APIs. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile Condition="'$(VeilWebView2Sdk)' == ''">true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Never set by the default Debug/Release builds or installer. Separate output
       directory through the existing Configuration-specific OutputPath. -->
  <PropertyGroup Condition="'$(Configuration)' == 'CefPreflight'">
    <DefineConstants>$(DefineConstants);VEIL_CEF_PREFLIGHT_ONLY</DefineConstants>
    <Product>VEIL CEF Preflight Validation Only</Product>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/veil.ico" />
    <Compile Include="../shared/AdminOnlyFile.cs" Link="Shared/AdminOnlyFile.cs" />
  </ItemGroup>
  <!-- Phase 4-0: the Rust vault bridge. Without it every download is blocked (never stored in plaintext). -->
  <ItemGroup Condition="Exists('../../crates/veil-security/target/release/veil-vault.exe')">
    <None Include="../../crates/veil-security/target/release/veil-vault.exe" Link="veil-vault.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(VeilWebView2Sdk)' == ''">
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4370.26]" />
  </ItemGroup>
  <ItemGroup Condition="'$(VeilWebView2Sdk)' != ''">
    <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(VeilWebView2Sdk)/Microsoft.Web.WebView2.Core.dll" />
    <Reference Include="Microsoft.Web.WebView2.Wpf" HintPath="$(VeilWebView2Sdk)/Microsoft.Web.WebView2.Wpf.dll" />
    <None Include="$(VeilWebView2Sdk)/runtimes/win-x64/native/WebView2Loader.dll"
          Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
