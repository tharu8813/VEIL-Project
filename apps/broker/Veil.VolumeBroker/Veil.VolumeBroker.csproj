<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);VEIL_CEF_BROKER</DefineConstants>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shared/AdminOnlyFile.cs" Link="Shared/AdminOnlyFile.cs" />
    <!-- Same strict registration/retained file checks on both sides of the pipe. -->
    <Compile Include="../../desktop/Engine/CefRuntimeFileLease.cs" Link="Shared/CefRuntimeFileLease.cs" />
    <Compile Include="../../desktop/Engine/CefRuntimeRegistrationLease.cs" Link="Shared/CefRuntimeRegistrationLease.cs" />
    <Compile Include="../../desktop/Engine/CefContainedProcess.cs" Link="Shared/CefContainedProcess.cs" />
    <Compile Include="../../desktop/Engine/CefProfileLayout.cs" Link="Shared/CefProfileLayout.cs" />
    <Compile Include="../../desktop/Engine/CefChildEnvironmentPlan.cs" Link="Shared/CefChildEnvironmentPlan.cs" />
  </ItemGroup>
</Project>
